<?xml version="1.0" encoding="utf-8"?>
<!-- Mimir launcher background — deep nordic blue gradient -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#1E3A5F" />
                <item android:offset="0.6" android:color="#162B47" />
                <item android:offset="1.0" android:color="#0A1730" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle rune accent circle, top-right -->
    <path
        android:pathData="M84,28 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:fillColor="#15243C" />
    <path
        android:pathData="M84,28 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:strokeColor="#22344F"
        android:strokeWidth="0.6"
        android:fillColor="#00000000" />
</vector>
