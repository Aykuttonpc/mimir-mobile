<?xml version="1.0" encoding="utf-8"?>
<!-- Mimir launcher foreground — stilize Mannaz rune (M) — bilgelik runesi -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Mannaz rune: iki dikey + ortada X (Norse "Mannaz" — insanı/bilgeliği temsil eder) -->
    <!-- Stroke-based, modern geometric, parchment cream color -->

    <!-- Sol dikey -->
    <path
        android:pathData="M36,30 L36,80"
        android:strokeColor="#FAF7F0"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Sağ dikey -->
    <path
        android:pathData="M72,30 L72,80"
        android:strokeColor="#FAF7F0"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Sol çapraz (yukarıdan ortaya) -->
    <path
        android:pathData="M36,30 L54,55"
        android:strokeColor="#E5C589"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Sağ çapraz (yukarıdan ortaya) -->
    <path
        android:pathData="M72,30 L54,55"
        android:strokeColor="#E5C589"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Ufak amber dot — Mimir's well drop -->
    <path
        android:pathData="M54,72 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#E5C589" />
</vector>
